<Window x:Class="TerminGenie.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TerminGenie"
        mc:Ignorable="d"
        Title="Terminvereinbarung" Height="700" Width="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <!-- Nationality selection -->
            <TextBlock Text="Staatsangehörigkeit (Wenn Sie staatenlos sind: Wählen Sie bitte den Staat aus, aus dem Sie oder Ihre Eltern stammen.)" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox Margin="0,0,0,20">
                <ComboBoxItem Content="Bitte auswählen" IsSelected="True"/>
                <!-- Additional ComboBoxItems for nationality based on the screenshots -->
                <!-- Repeat for each nationality option provided -->
            </ComboBox>

            <!-- Number of people selection -->
            <TextBlock Text="Anzahl der Personen, die einen Aufenthaltstitel beantragen (auch ausländische Ehepartner und Kinder)" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox Margin="0,0,0,20">
                <ComboBoxItem Content="Bitte auswählen" IsSelected="True"/>
                <!-- Additional ComboBoxItems for number of people -->
                <ComboBoxItem Content="eine Person"/>
                <ComboBoxItem Content="zwei Personen"/>
                <!-- Repeat for each option provided up to "acht Personen" -->
            </ComboBox>

            <!-- Reasons for the appointment -->
            <TextBlock Text="Leben Sie in Berlin zusammen mit einem Familienangehörigen (z.B. Ehepartner, Kind)" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox Margin="0,0,0,20">
                <ComboBoxItem Content="nein" IsSelected="True"/>
                <!-- Additional ComboBoxItems for reasons -->
                <ComboBoxItem Content="Aufenthaltstitel - beantragen"/>
                <ComboBoxItem Content="Aufenthaltstitel - verlängern"/>
                <!-- Repeat for each option provided -->
            </ComboBox>

            <!-- Specific options for each reason -->
            <TextBlock Text="Studium und Ausbildung" FontWeight="Bold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <!-- CheckBoxes for specific options -->
                <CheckBox Content="Studium"/>
                <CheckBox Content="Ausbildung"/>
                <!-- Additional CheckBoxes as needed -->
            </StackPanel>

            <!-- Subsections for a selected reason -->
            <Expander Header="Erwerbstätigkeit" IsExpanded="True" Margin="0,0,0,20">
                <StackPanel>
                    <!-- CheckBoxes for Erwerbstätigkeit subsections -->
                    <CheckBox Content="Aufenthaltserlaubnis für Fachkräfte mit akademischer Ausbildung (§ 18b)"/>
                    <CheckBox Content="Aufenthaltserlaubnis für Fachkräfte mit Berufsausbildung (§ 18a)"/>
                    <!-- Repeat for each option provided -->
                </StackPanel>
            </Expander>

            <!-- Other sections can be added in similar Expander controls -->
            <!-- ... -->

            <Button Content="Weiter" Margin="0,20,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
