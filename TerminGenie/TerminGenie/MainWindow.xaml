<Window x:Class="TerminGenie.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminauswahl" Height="700" Width="800">

    <Window.Resources>
        <!-- Style for the Start Button -->
        <Style x:Key="StartButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Beige"/>
            <Setter Property="Margin" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="5" Opacity="0.7" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for the Attribution Text -->
        <Style x:Key="AttributionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <!-- Style for ComboBox -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Main Grid -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo Section -->
        <Image Source="/Logo.png" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="250" Height="250"/>

        <!-- ComboBox Selection -->
        <ComboBox x:Name="countryComboBox" Grid.Row="1" Style="{StaticResource ComboBoxStyle}" SelectionChanged="ComboBox_SelectionChanged" HorizontalAlignment="Left" Margin="29,1,0,0" VerticalAlignment="Top">
            <ComboBoxItem Content="Tunesien"/>
            <ComboBoxItem Content="Indien"/>
            <ComboBoxItem Content="Soudan"/>
            <ComboBoxItem Content="Ägypten"/>
            <!-- Add more ComboBoxItems here -->
        </ComboBox>

        <!-- Attribution Text -->
        <TextBlock Text="Developed by T.Wadi" Grid.Row="2" Style="{StaticResource AttributionTextStyle}" HorizontalAlignment="Center"/>

        <!-- Start Button Section -->
        <Button Content="Start" Grid.Row="3" Click="OnStartButtonClick" Style="{StaticResource StartButtonStyle}" HorizontalAlignment="Center"/>
        <Button x:Name="TestMode" Content="TestMode" HorizontalAlignment="Left" Margin="668,36,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.429,-3.856" Height="39" Width="103" Click="Button_Click" Background="#FF007ACC" BorderBrush="White" Foreground="White">
            <Button.OpacityMask>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </Button.OpacityMask>
        </Button>
        <ComboBox HorizontalAlignment="Left" VerticalAlignment="Center" Width="177" Height="31" Grid.Row="1" Margin="584,0,0,0" SelectionChanged="delay_SelectionChanged">
            <ComboBoxItem Content="5"/>
            <ComboBoxItem Content="10"/>
            <ComboBoxItem Content="15"/>
            <ComboBoxItem Content="20"/>
            <ComboBoxItem Content="25"/>
        </ComboBox>

    </Grid>
</Window>
